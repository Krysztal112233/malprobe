POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

MALPROBE__DATABASE__DSN=${DATABASE_URL}
MALPROBE__ADDR=0.0.0.0:8000

# Browser CORS for the web UI: "*" = any origin (development), a
# comma-separated list restricts to those origins, absent disables CORS.
# Uncomment to enable; keep unset (or empty) for a closed API.
# MALPROBE__CORS__ALLOW_ORIGINS=*
